# 复制为 .env 并填写真实值。.env 已被 .gitignore 忽略,绝不提交。

# ---- LLM ----
# 至少填一个,根据实际使用的服务选择
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# DeepSeek(OpenAI 兼容接口)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---- Embedding ----
# 本地模型(用 HuggingFace 模型名)或 API
EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_API_KEY=

# ---- Rerank ----
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---- 运行 ----
# 让 src 包可直接 import
PYTHONPATH=src
